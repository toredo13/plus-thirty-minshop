---
/**
 * Permanent redirect to the plural canonical product URL.
 * Keep this route indefinitely because legacy product links may already be
 * present in search indexes, sitemaps, bookmarks, and external links.
 * Preserve query parameters such as ?error= and ?canceled=.
 */
return Astro.redirect(`/products/${Astro.params.slug}${Astro.url.search}`, 301);
---
