---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import { getConfig, formatPrice } from '../config';
import { readCart, resolveCart } from '../features/cart/cart';
import { getProductByPublicId, type Product } from '../features/products/db';
import { listVariants, getExtrasByPublicIds, type ProductVariant } from '../features/products/variants';
import { parsePublicId } from '../features/ids/publicId';
import {
  claimOrderIdentity,
  deleteGuestAccessIfUnsettled,
} from '../features/orders/guestAccess';
import { lineUnitPriceCents } from '../features/cart/key';
import { quoteShipping, allowedCountries, hasCatchAllZone, type ShippingOption } from '../features/shipping/calculator';
import { shippingFor } from '../features/shipping/effective';
import { shipmentWeightFor } from '../features/shipping/lines';
import { findPickupPoints, isPickupCarrier, type PickupCarrier, type PickupPoint } from '../features/shipping/pickupPoints';
import { getSecret } from '../features/secrets/store';
import { fetchShipmondoProducts, type ShipmondoProduct } from '../features/shipping/shipmondo';
import {
  checkoutCarriers,
  shippingConfigForChoice,
  shipmondoProductForCheckout,
  type CheckoutDeliveryChoice,
} from '../features/shipping/checkout';
import { getLightningBackend } from '../features/payments/lightning';
import { mintLightningOrder } from '../features/payments/lightning-provider';
import {
  DEMO_CHECKOUT_TTL_SECONDS,
  STRIPE_CHECKOUT_TTL_SECONDS,
  isMethodAvailable,
  getPaymentProvider,
} from '../features/payments';
import {
  reserveInventory,
  releaseInventoryReservation,
  type ReservationItem,
} from '../features/orders/reservations';
import { purgeStockProductCache } from '../features/cache/purge';

const cfg = getConfig();
const isPost = Astro.request.method === 'POST';
const form = isPost ? await Astro.request.formData() : null;
const fld = (name: string) => (form?.get(name) ?? '').toString().trim();

/**
 * The in-app shipping checkout, shared by every rail that cannot collect a
 * destination on its own hosted page: Lightning has no hosted page at all,
 * OpenNode's ignores addresses, and Demo has none. Stripe skips this — it collects
 * the address itself, after the session is created.
 *
 * Gate on the chosen rail being AVAILABLE (configured), not on it being the
 * default. Every in-app rail collects the destination here before payment so
 * Minshop can validate Danish parcel-shop selections and preserve them on orders.
 * The rail arrives as a query param on the first hop and as a hidden field across
 * the address → shipping steps (the forms post to a bare /checkout).
 */
const IN_APP_RAILS = ['lightning', 'opennode', 'demo', 'stripe'] as const;
type InAppRail = (typeof IN_APP_RAILS)[number];
const requestedRail = (fld('method') || Astro.url.searchParams.get('method') || '').trim();
const rail: InAppRail = (IN_APP_RAILS as readonly string[]).includes(requestedRail)
  ? (requestedRail as InAppRail)
  : 'lightning';
if (!Astro.locals.settings || !isMethodAvailable(rail, Astro.locals.settings))
  return Astro.redirect('/cart', 303);

// Order lines: buy-now (product_id [+ variant/extras]) or the whole cart. All
// selectors arrive as prefixed public IDs (prod_/var_/xtra_ — api/checkout.ts
// routes here with them); numeric row IDs are never accepted.
const productPublicId = parsePublicId(
  fld('product_id') || (Astro.url.searchParams.get('product_id') ?? ''),
  'product',
);
// Express buy-now carries variant + extras — in the query on the first hop, then
// as hidden fields across the address → shipping steps.
const buyNowVariantId = parsePublicId(
  fld('variant_id') || Astro.url.searchParams.get('variant_id') || '',
  'variant',
);
const buyNowExtraIds = (isPost ? form!.getAll('extra') : Astro.url.searchParams.getAll('extra'))
  .map((e) => parsePublicId(e, 'extra'))
  .filter((x): x is string => x !== null);

interface CheckoutLine {
  product: Product;
  qty: number;
  name: string;
  unitPriceCents: number;
  variantId: number | null;
  /** Carried (not just its id) because shipment weight needs the variant's own
   *  weight, which overrides the product's. */
  variant: ProductVariant | null;
}
let lines: CheckoutLine[] = [];
if (productPublicId) {
  const product = await getProductByPublicId(env.DB, productPublicId);
  if (product && product.active) {
    const variants = await listVariants(env.DB, product.id);
    const variant =
      variants.length > 0 && buyNowVariantId
        ? (variants.find((v) => v.public_id === buyNowVariantId) ?? null)
        : null;
    const extras = buyNowExtraIds.length
      ? await getExtrasByPublicIds(env.DB, product.id, buyNowExtraIds)
      : [];
    lines = [
      {
        product,
        qty: 1,
        name:
          product.name +
          (variant ? ` — ${variant.label}` : '') +
          (extras.length ? ` (${extras.map((e) => e.label).join(', ')})` : ''),
        unitPriceCents: lineUnitPriceCents(product.price_cents, variant, extras),
        variantId: variant?.id ?? null,
        variant,
      },
    ];
  }
} else {
  const { lines: cartLines } = await resolveCart(env.DB, readCart(Astro.cookies));
  lines = cartLines.map((l) => ({
    product: l.product,
    qty: l.qty,
    name:
      l.product.name +
      (l.variant ? ` — ${l.variant.label}` : '') +
      (l.extras.length ? ` (${l.extras.map((e) => e.label).join(', ')})` : ''),
    unitPriceCents: l.unitPriceCents,
    variantId: l.variant?.id ?? null,
    variant: l.variant,
  }));
}
if (lines.length === 0) return Astro.redirect('/cart', 303);

const subtotalCents = lines.reduce((s, l) => s + l.unitPriceCents * l.qty, 0);
const currency = cfg.currency;
const effectiveShipping = shippingFor(Astro.locals.settings).config;
const knownCountries = allowedCountries(effectiveShipping);
const shipsAnywhere = hasCatchAllZone(effectiveShipping);
const shipment = shipmentWeightFor(lines);
const shippingApplies = effectiveShipping.enabled && shipment.shippingRequired;
const supportsDenmark = shipsAnywhere || knownCountries.includes('DK');

// Shipmondo credentials stay encrypted in Minshop's D1 vault. Only Danish
// carrier services are shown in this checkout.
let shipmondoProducts: ShipmondoProduct[] = [];
let shipmondoError: string | null = null;
if (shippingApplies && rail !== 'demo') {
  const [username, apiKey] = await Promise.all([
    getSecret(env.DB, 'shipmondo_api_user'),
    getSecret(env.DB, 'shipmondo_api_key'),
  ]);
  if (!username || !apiKey) {
    shipmondoError = 'Shipmondo is not connected yet. Add the API username and API key in Admin → Settings.';
  } else {
    const result = await fetchShipmondoProducts(username, apiKey, 'DK');
    if (result.ok) shipmondoProducts = result.value;
    else shipmondoError = result.error;
  }
}

const shipmondoCarriers = [
  ...new Set([
    ...checkoutCarriers(shipmondoProducts, 'home'),
    ...checkoutCarriers(shipmondoProducts, 'pickup'),
  ]),
];
const requestedCarrier = fld('shipmondo_carrier') || Astro.url.searchParams.get('shipmondo_carrier') || '';
const carrier: PickupCarrier =
  isPickupCarrier(requestedCarrier) && shipmondoCarriers.includes(requestedCarrier)
    ? requestedCarrier
    : (shipmondoCarriers[0] ?? 'gls');
const requestedChoice = fld('delivery_choice') || Astro.url.searchParams.get('delivery_choice') || '';
const deliveryChoice: CheckoutDeliveryChoice =
  requestedChoice === 'pickup'
    ? 'pickup'
    : requestedChoice === 'home'
      ? 'home'
      : rail === 'demo'
        ? 'home'
        : shipmondoProductForCheckout(shipmondoProducts, carrier, 'home')
          ? 'home'
          : 'pickup';
const selectedShipmondoProduct =
  rail === 'demo' ? null : shipmondoProductForCheckout(shipmondoProducts, carrier, deliveryChoice);

// Product/cart IDs continue through every checkout step unchanged.
const carry = productPublicId ?? '';
const carryVariantId = buyNowVariantId ?? '';
const carryExtraIds = buyNowExtraIds;
const editAddressHref = (() => {
  const params = new URLSearchParams({
    method: rail,
    shipmondo_carrier: carrier,
    delivery_choice: deliveryChoice,
  });
  if (carry) params.set('product_id', carry);
  if (carryVariantId) params.set('variant_id', carryVariantId);
  for (const id of carryExtraIds) params.append('extra', id);
  return `/checkout?${params}`;
})();

const DEMO_ADDRESS = {
  email: 'demo@example.com',
  name: 'Demo Shopper',
  line1: 'Example Street 1',
  line2: '',
  city: 'Copenhagen',
  state: '',
  postal: '2500',
  country: 'DK',
};
const prefill = rail === 'demo' && !isPost ? DEMO_ADDRESS : null;
const addr = {
  email: fld('email') || (prefill?.email ?? ''),
  name: fld('name') || (prefill?.name ?? ''),
  line1: fld('line1') || (prefill?.line1 ?? ''),
  line2: fld('line2') || (prefill?.line2 ?? ''),
  city: fld('city') || (prefill?.city ?? ''),
  state: fld('state') || (prefill?.state ?? ''),
  postal: fld('postal') || (prefill?.postal ?? ''),
  country: 'DK',
  phone: fld('phone') || '',
};
const pickupSearchPostal = fld('pickup_search_postal');
const RAIL_LABEL: Record<InAppRail, string> = {
  lightning: 'Pay with Lightning',
  opennode: 'Pay with Bitcoin',
  demo: 'Place demo order',
  stripe: 'Pay by card',
};


let stage: 'delivery' | 'shipping' = 'delivery';
let options: ShippingOption[] = [];
let selectedPickupPoint: PickupPoint | null = null;
let quote: ReturnType<typeof quoteShipping> | null = null;
const errors: string[] = [];

// First choose carrier + pickup/home. The following POST validates the choice,
// quotes the configured Minshop delivery price, and then continues to payment.
const submitted = isPost || rail === 'demo';
if (submitted) {
  if (!/.+@.+\..+/.test(addr.email)) errors.push('A valid email is required.');
  if (!addr.name) errors.push('Name is required.');
  if (!supportsDenmark) errors.push('Denmark is not included in the store’s shipping destinations.');
  if (rail !== 'demo' && shipmondoError) errors.push(`Shipmondo connection failed: ${shipmondoError}`);
  if (rail !== 'demo' && !isPickupCarrier(requestedCarrier)) errors.push('Choose a shipping carrier.');
  if (rail !== 'demo' && !selectedShipmondoProduct) {
    errors.push(`The selected carrier does not offer ${deliveryChoice === 'pickup' ? 'parcel-shop' : 'home'} delivery through your Shipmondo account.`);
  }
  if (selectedShipmondoProduct?.requiredFields.includes('receiver_mobile') && !addr.phone) {
    errors.push('This Shipmondo service requires your mobile number.');
  }
  if (selectedShipmondoProduct?.requiredFields.includes('receiver_email') && !addr.email) {
    errors.push('This Shipmondo service requires your email address.');
  }

  if (deliveryChoice === 'pickup') {
    if (!/^\d{4}$/.test(pickupSearchPostal)) errors.push('Enter a 4-digit postcode to find nearby parcel shops.');
    const pointId = fld('pickup_point_id');
    if (!isPickupCarrier(carrier) || !pointId) {
      errors.push('Search and choose one of the three nearby parcel shops.');
    } else if (errors.length === 0) {
      const lookup = await findPickupPoints(env.DB, carrier, pickupSearchPostal, '');
      if (!lookup.ok) {
        errors.push(lookup.error);
      } else {
        selectedPickupPoint = lookup.points.find((point) => point.id === pointId) ?? null;
        if (!selectedPickupPoint) {
          errors.push('That parcel shop could not be verified. Search again and choose one of the listed shops.');
        } else {
          // For parcel-shop delivery, the parcel shop is the shipment destination.
          addr.line1 = selectedPickupPoint.street;
          addr.line2 = '';
          addr.city = selectedPickupPoint.city;
          addr.postal = selectedPickupPoint.zip;
          addr.state = '';
        }
      }
    }
  } else {
    if (!addr.line1) errors.push('Street address is required for home delivery.');
    if (!addr.city) errors.push('City is required for home delivery.');
    if (!/^\d{4}$/.test(addr.postal)) errors.push('Enter a valid 4-digit Danish postcode.');
  }

  if (errors.length === 0) {
    const modeConfig = shippingConfigForChoice(effectiveShipping, deliveryChoice);
    quote = quoteShipping(modeConfig, {
      subtotalCents,
      country: 'DK',
      itemWeightGrams: shipment.itemWeightGrams,
      missingWeight: shipment.missingWeight,
    });
    options = quote.options;
    if (options.length === 0) {
      const missing = quote.omitted.some((o) => o.reason === 'missing_weight');
      const overweight = quote.omitted.some((o) => o.reason === 'overweight');
      if (missing) {
        console.error(
          JSON.stringify({
            event: 'shipping_quote_blocked',
            reason: 'missing_weight',
            country: 'DK',
            products: quote.missingWeight.map(
              (m) => lines.find((l) => l.product.id === m.productId)?.product.public_id ?? m.name,
            ),
          }),
        );
        errors.push(
          `We can't calculate shipping for ${quote.missingWeight.map((m) => m.name).join(', ')} right now. Please contact us to complete this order.`,
        );
      } else if (overweight) {
        errors.push('This order is too heavy for the available shipping services.');
      } else if (modeConfig.zones.length === 0) {
        errors.push(
          deliveryChoice === 'pickup'
            ? 'No parcel-shop shipping price is configured. Add a Parcel shop delivery rate in Admin → Shipping.'
            : 'No home-delivery shipping price is configured. Add a flat or weight-based rate in Admin → Shipping.',
        );
      } else {
        errors.push('Shipmondo has no available shipping option for this delivery choice.');
      }
    } else {
      stage = 'shipping';
      // The selected delivery rate and Shipmondo delivery product are verified
      // again on the final POST; no label is booked during checkout.
      const chosenLabel = fld('shipping_label') || (rail === 'demo' ? (options[0]?.label ?? '') : '');
      if (chosenLabel) {
        const chosen = options.find((option) => option.label === chosenLabel);
        if (!chosen) {
          errors.push('Please choose a shipping option.');
        } else if (
          (deliveryChoice === 'pickup' && !chosen.servicePoint) ||
          (deliveryChoice === 'home' && (chosen.servicePoint || chosen.pickup))
        ) {
          errors.push('Choose a shipping price that matches the delivery method.');
        } else if (deliveryChoice === 'pickup' && !selectedPickupPoint) {
          errors.push('Choose a parcel shop before continuing.');
        } else {
            // Finalize: mint the invoice for subtotal + the chosen shipping.
            // Claim the order's public identity + guest credential BEFORE the
            // provider handoff: the ord_ id ties reservation → pending payment →
            // settled order, and the access token is the only thing guest URLs
            // carry. Reservations keep using the ord_ public id.
            const { publicId, accessToken } = await claimOrderIdentity(env.DB);
            const reservedItems: ReservationItem[] = lines.map((line) => ({
              productId: line.product.id,
              variantId: line.variantId,
              name: line.name,
              priceCents: line.unitPriceCents,
              quantity: line.qty,
            }));
            const reservationTtl =
              rail === 'demo'
                ? DEMO_CHECKOUT_TTL_SECONDS
                : rail === 'stripe'
                  ? STRIPE_CHECKOUT_TTL_SECONDS
                  : cfg.payments.lightning.invoiceExpiryMinutes * 60 + 5 * 60;
            const reserved = await reserveInventory(
              env.DB,
              publicId,
              reservedItems,
              reservationTtl,
              rail,
              purgeStockProductCache,
            );
            if (!reserved) {
              await deleteGuestAccessIfUnsettled(env.DB, publicId);
              errors.push('Some inventory just sold out — please review your cart.');
            } else {
              const shippingAddress = {
                name: addr.name,
                line1: addr.line1,
                line2: addr.line2 || null,
                city: addr.city,
                state: addr.state || null,
                postal: addr.postal,
                country: addr.country,
                phone: addr.phone || null,
                servicePoint: selectedPickupPoint,
                shipmondoCarrier: carrier,
                shipmondoProductCode: selectedShipmondoProduct?.code ?? null,
                deliveryChoice,
              };
              const itemsJson = JSON.stringify(
                lines.map((l) => ({ id: l.product.id, v: l.variantId, q: l.qty, n: l.name, p: l.unitPriceCents })),
              );
              try {
                // Hosted providers receive the already-selected rate and address,
                // including the parcel shop, rather than guessing from an option list.
                if (rail !== 'lightning') {
                  const provider = await getPaymentProvider(rail);
                  const result = await provider.createCheckout({
                    lineItems: lines.map((l) => ({
                      name: l.name,
                      amountCents: l.unitPriceCents,
                      currency,
                      quantity: l.qty,
                    })),
                    successUrl: `${Astro.url.origin}/order/${accessToken}`,
                    cancelUrl: `${Astro.url.origin}/cart`,
                    orderItemsJson: itemsJson,
                    // Provider metadata NEVER carries the access token.
                    metadata: { public_id: publicId, reservation_id: publicId },
                    accessToken,
                    selectedShipping: {
                      label: chosen.label,
                      amountCents: chosen.amountCents,
                      weightGrams: quote.shipmentWeightGrams,
                      deliveryMethod: chosen.pickup ? 'pickup' : 'shipping',
                      address: shippingAddress,
                      email: addr.email,
                    },
                  });
                  return Astro.redirect(result.url, 303);
                }
                const minted = await mintLightningOrder(env.DB, await getLightningBackend(), {
                  origin: Astro.url.origin,
                  publicId,
                  accessToken,
                  currency,
                  subtotalCents,
                  shippingCents: chosen.amountCents,
                  shippingLabel: chosen.label,
                  shippingWeightGrams: quote.shipmentWeightGrams,
                  deliveryMethod: chosen.pickup ? 'pickup' : 'shipping',
                  itemsJson,
                  email: addr.email,
                  shippingAddress,
                  reservationId: publicId,
                });
                if (!minted.payUrl) throw new Error('Lightning backend did not return a payment URL.');
                return Astro.redirect(minted.payUrl, 303);
              } catch (error) {
                // The Lightning node (e.g. LNbits) can be briefly unreachable. Free
                // the whole claim — held stock AND the guest credential — and show
                // a retryable message instead of a 500, so the shopper can try
                // again or pick another method.
                await releaseInventoryReservation(env.DB, publicId, purgeStockProductCache);
                await deleteGuestAccessIfUnsettled(env.DB, publicId);
                console.error(
                  JSON.stringify({
                    event: rail === 'lightning' ? 'lightning_invoice_failed' : 'checkout_create_failed',
                    rail,
                    message: error instanceof Error ? error.message : String(error),
                  }),
                );
                errors.push(
                  rail === 'lightning'
                    ? 'Lightning is temporarily unavailable. Please try again in a moment, or choose another payment method.'
                    : 'That payment method is temporarily unavailable. Please try again in a moment, or choose another.',
                );
              }
            }

        }
      }
    }
  }
}

const showShipping = stage === 'shipping';
const hasErrors = errors.length > 0;
const postedShippingLabel = fld('shipping_label');
const initialShippingLabel = options.some((option) => option.label === postedShippingLabel)
  ? postedShippingLabel
  : (options[0]?.label ?? '');

---

<Layout title="Checkout" description="Enter your shipping details.">
  <div class="mx-auto max-w-lg">
    {
      rail === 'demo' && (
        <div class="mb-6 rounded-lg border-2 border-amber-400 bg-amber-50 px-4 py-4 text-center text-amber-900">
          <p class="text-base font-bold uppercase tracking-wide">⚠️ Demo checkout — not a real payment</p>
          <p class="mt-1 text-sm">
            No card is charged. Completing it places a real order tagged
            <code class="rounded bg-amber-100 px-1">demo</code> so you can see the full flow.
          </p>
        </div>
      )
    }
    <h1 class="mb-1 font-serif text-3xl tracking-tight sm:text-4xl">Checkout</h1>
    <p class="mb-6 text-sm text-muted">
      Subtotal {formatPrice(subtotalCents, currency)} · {lines.length} item{lines.length === 1 ? '' : 's'}
    </p>

    {
      hasErrors && (
        <ul class="mb-4 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-700">
          {errors.map((e) => (
            <li>{e}</li>
          ))}
        </ul>
      )
    }

    {
      showShipping ? (
        <form method="POST" action="/checkout" class="space-y-4">
          <input type="hidden" name="method" value={rail} />
          <input type="hidden" name="product_id" value={carry} />
          {carryVariantId && <input type="hidden" name="variant_id" value={carryVariantId} />}
          {carryExtraIds.map((id) => <input type="hidden" name="extra" value={id} />)}
          <input type="hidden" name="delivery_choice" value={deliveryChoice} />
          <input type="hidden" name="shipmondo_carrier" value={carrier} />
          <input type="hidden" name="email" value={addr.email} />
          <input type="hidden" name="name" value={addr.name} />
          <input type="hidden" name="line1" value={addr.line1} />
          <input type="hidden" name="line2" value={addr.line2} />
          <input type="hidden" name="city" value={addr.city} />
          <input type="hidden" name="state" value={addr.state} />
          <input type="hidden" name="postal" value={addr.postal} />
          <input type="hidden" name="country" value="DK" />
          <input type="hidden" name="phone" value={addr.phone} />
          <input type="hidden" name="pickup_search_postal" value={pickupSearchPostal} />
          <input type="hidden" name="pickup_point_id" value={selectedPickupPoint?.id ?? ''} />

          <div class="rounded-lg border border-line bg-surface p-4 text-sm">
            <div class="mb-1 font-medium">
              {deliveryChoice === 'pickup' ? 'Pickup point' : 'Home delivery'}
            </div>
            <div class="text-muted">
              {carrier.toUpperCase()} · {addr.name}
              {deliveryChoice === 'pickup'
                ? ` · ${selectedPickupPoint?.name ?? ''}, ${addr.line1}, ${addr.postal} ${addr.city}`
                : ` · ${addr.line1}, ${addr.city} ${addr.postal}`}
            </div>
            <a href={editAddressHref} class="mt-2 inline-block text-xs font-medium text-accent">
              Edit delivery details
            </a>
          </div>

          <fieldset class="space-y-2">
            <legend class="mb-1 text-sm font-medium">Shipping price</legend>
            {options.map((option, index) => (
              <label class="flex cursor-pointer items-center justify-between rounded-lg border border-line bg-surface p-3 text-sm has-[:checked]:border-brand">
                <span class="flex items-center gap-2">
                  <input
                    type="radio"
                    name="shipping_label"
                    value={option.label}
                    checked={option.label === initialShippingLabel || (!initialShippingLabel && index === 0)}
                  />
                  {option.label}
                </span>
                <span class="text-muted">
                  {option.amountCents === 0 ? 'Free' : formatPrice(option.amountCents, currency)} · total{' '}
                  {formatPrice(subtotalCents + option.amountCents, currency)}
                </span>
              </label>
            ))}
          </fieldset>

          <button
            type="submit"
            class="w-full rounded-md bg-brand px-4 py-2.5 font-medium text-on-brand hover:bg-brand-hover"
          >
            {RAIL_LABEL[rail]} →
          </button>
        </form>
      ) : (
        <form method="POST" action="/checkout" class="space-y-4" data-checkout-delivery>
          <input type="hidden" name="method" value={rail} />
          <input type="hidden" name="product_id" value={carry} />
          {carryVariantId && <input type="hidden" name="variant_id" value={carryVariantId} />}
          {carryExtraIds.map((id) => <input type="hidden" name="extra" value={id} />)}

          <div>
            <p class="mb-2 text-sm font-medium">1. Choose your shipping carrier</p>
            <select
              id="shipmondo-carrier"
              name="shipmondo_carrier"
              required
              class="w-full rounded-md border border-line bg-surface px-3 py-2"
              disabled={shipmondoCarriers.length === 0 && rail !== 'demo'}
            >
              {shipmondoCarriers.map((choice) => (
                <option
                  value={choice}
                  selected={choice === carrier}
                  data-has-home={shipmondoProductForCheckout(shipmondoProducts, choice, 'home') ? '1' : '0'}
                  data-has-pickup={shipmondoProductForCheckout(shipmondoProducts, choice, 'pickup') ? '1' : '0'}
                >
                  {choice === 'gls' ? 'GLS' : choice === 'postnord' ? 'PostNord' : 'DAO'}
                </option>
              ))}
              {shipmondoCarriers.length === 0 && rail === 'demo' && (
                <option value="gls" selected data-has-home="1" data-has-pickup="0">GLS</option>
              )}
            </select>
            {shipmondoError && rail !== 'demo' && (
              <p class="mt-2 text-xs text-red-700">{shipmondoError}</p>
            )}
            {!selectedShipmondoProduct && !shipmondoError && rail !== 'demo' && (
              <p class="mt-2 text-xs text-amber-700">
                No matching Shipmondo service is available for this carrier and delivery type.
              </p>
            )}
          </div>

          <fieldset class="space-y-2">
            <legend class="mb-2 text-sm font-medium">2. Choose how you want to receive your order</legend>
            <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-line bg-surface p-3 text-sm has-[:checked]:border-brand">
              <input type="radio" name="delivery_choice" value="pickup" checked={deliveryChoice === 'pickup'} />
              <span>Pickup point (choose one of 3 nearby shops)</span>
            </label>
            <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-line bg-surface p-3 text-sm has-[:checked]:border-brand">
              <input type="radio" name="delivery_choice" value="home" checked={deliveryChoice === 'home'} />
              <span>Home delivery</span>
            </label>
          </fieldset>

          <div class="rounded-lg border border-line bg-surface p-4 space-y-3">
            <p class="text-sm font-medium">Your contact details</p>
            <label class="block text-sm">
              <span class="mb-1 block font-medium">Email</span>
              <input type="email" name="email" value={addr.email} required autocomplete="email" class="w-full rounded-md border border-line px-3 py-2" />
            </label>
            <label class="block text-sm">
              <span class="mb-1 block font-medium">Full name</span>
              <input type="text" name="name" value={addr.name} required autocomplete="name" class="w-full rounded-md border border-line px-3 py-2" />
            </label>
            <label class="block text-sm">
              <span class="mb-1 block font-medium">Phone / mobile</span>
              <input
                type="tel"
                name="phone"
                value={addr.phone}
                autocomplete="tel"
                required={!!selectedShipmondoProduct?.requiredFields.includes('receiver_mobile')}
                class="w-full rounded-md border border-line px-3 py-2"
              />
            </label>
          </div>

          <section id="pickup-point-picker" class="rounded-lg border border-line bg-surface p-4 space-y-3" hidden={deliveryChoice !== 'pickup'}>
            <div>
              <h2 class="text-sm font-medium">3. Find your 3 nearest pickup points</h2>
              <p class="mt-1 text-xs text-muted">Enter your postcode to find nearby shops for the selected carrier.</p>
            </div>
            <label class="block text-sm">
              <span class="mb-1 block font-medium">Postcode</span>
              <input id="pickup-search-postal" name="pickup_search_postal" value={pickupSearchPostal} inputmode="numeric" maxlength="4" class="w-full rounded-md border border-line px-3 py-2" />
            </label>
            <button id="pickup-point-search" type="button" class="rounded-md border border-line px-4 py-2 text-xs font-medium uppercase tracking-wider hover:border-brand">
              Find 3 nearby pickup points
            </button>
            <p id="pickup-point-message" role="status" aria-live="polite" class="text-xs text-muted"></p>
            <div id="pickup-point-results" class="space-y-2"></div>
            <input type="hidden" name="pickup_point_id" id="pickup-point-id" value={fld('pickup_point_id')} />
            <p id="pickup-point-selected" class="text-xs font-medium text-green-700" hidden></p>
          </section>

          <section id="home-delivery-fields" class="rounded-lg border border-line bg-surface p-4 space-y-3" hidden={deliveryChoice !== 'home'}>
            <h2 class="text-sm font-medium">3. Home delivery address</h2>
            <label class="block text-sm">
              <span class="mb-1 block font-medium">Street address</span>
              <input type="text" name="line1" value={addr.line1} autocomplete="address-line1" class="w-full rounded-md border border-line px-3 py-2" />
            </label>
            <label class="block text-sm">
              <span class="mb-1 block font-medium">Apartment, suite, etc. (optional)</span>
              <input type="text" name="line2" value={addr.line2} autocomplete="address-line2" class="w-full rounded-md border border-line px-3 py-2" />
            </label>
            <div class="grid grid-cols-2 gap-3">
              <label class="block text-sm">
                <span class="mb-1 block font-medium">City</span>
                <input type="text" name="city" value={addr.city} autocomplete="address-level2" class="w-full rounded-md border border-line px-3 py-2" />
              </label>
              <label class="block text-sm">
                <span class="mb-1 block font-medium">Postcode</span>
                <input type="text" name="postal" value={addr.postal} inputmode="numeric" maxlength="4" autocomplete="postal-code" class="w-full rounded-md border border-line px-3 py-2" />
              </label>
            </div>
            <input type="hidden" name="country" value="DK" />
            <input type="hidden" name="state" value="" />
          </section>

          <button
            type="submit"
            class="w-full rounded-md bg-brand px-4 py-2.5 font-medium text-on-brand hover:bg-brand-hover"
            disabled={shipmondoCarriers.length === 0 && rail !== 'demo'}
          >
            Continue to shipping →
          </button>
        </form>
      )
    }
  </div>
<script>
  const deliveryForm = document.querySelector<HTMLFormElement>('form[data-checkout-delivery]');
  const carrierSelect = document.getElementById('shipmondo-carrier') as HTMLSelectElement | null;
  const deliveryChoices = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="delivery_choice"]'));
  const pickupSection = document.getElementById('pickup-point-picker');
  const homeSection = document.getElementById('home-delivery-fields');
  const pickupPostal = document.getElementById('pickup-search-postal') as HTMLInputElement | null;
  const pickupSearch = document.getElementById('pickup-point-search') as HTMLButtonElement | null;
  const pickupMessage = document.getElementById('pickup-point-message');
  const pickupResults = document.getElementById('pickup-point-results');
  const pickupPointId = document.getElementById('pickup-point-id') as HTMLInputElement | null;
  const pickupSelected = document.getElementById('pickup-point-selected');

  if (deliveryForm && carrierSelect && pickupSection && homeSection) {
    const currentChoice = () => deliveryChoices.find((input) => input.checked)?.value ?? 'home';
    const clearPoint = () => {
      if (pickupPointId) pickupPointId.value = '';
      pickupResults?.replaceChildren();
      if (pickupSelected) {
        pickupSelected.textContent = '';
        pickupSelected.hidden = true;
      }
    };
    const syncDeliveryChoice = () => {
      const showPickup = currentChoice() === 'pickup';
      pickupSection.hidden = !showPickup;
      homeSection.hidden = showPickup;
      pickupSection.querySelectorAll<HTMLInputElement>('input').forEach((input) => {
        if (input !== pickupPointId) input.disabled = !showPickup;
      });
      homeSection.querySelectorAll<HTMLInputElement>('input').forEach((input) => {
        input.disabled = showPickup;
      });
      Array.from(carrierSelect.options).forEach((option) => {
        const supports = showPickup
          ? option.dataset.hasPickup !== '0'
          : option.dataset.hasHome !== '0';
        option.disabled = !supports;
      });
      if (carrierSelect.selectedOptions[0]?.disabled) {
        const next = Array.from(carrierSelect.options).find((option) => !option.disabled);
        if (next) carrierSelect.value = next.value;
      }
    };
    deliveryChoices.forEach((input) => input.addEventListener('change', () => {
      clearPoint();
      if (pickupMessage) pickupMessage.textContent = '';
      syncDeliveryChoice();
    }));
    carrierSelect.addEventListener('change', () => {
      clearPoint();
      if (pickupMessage) pickupMessage.textContent = '';
    });
    pickupPostal?.addEventListener('input', clearPoint);
    syncDeliveryChoice();

    if (pickupSearch && pickupMessage && pickupResults && pickupPointId && pickupPostal) {
      pickupSearch.addEventListener('click', async () => {
        const postal = pickupPostal.value.trim();
        if (!/^\d{4}$/.test(postal)) {
          pickupMessage.textContent = 'Enter a valid 4-digit Danish postcode.';
          return;
        }
        pickupSearch.disabled = true;
        pickupMessage.textContent = 'Searching Shipmondo for the 3 nearest pickup points…';
        clearPoint();
        try {
          const params = new URLSearchParams({ carrier: carrierSelect.value, zip: postal, street: '' });
          const response = await fetch(`/api/shipping/pickup-points?${params.toString()}`, {
            headers: { accept: 'application/json' },
          });
          const data = await response.json() as {
            ok?: boolean;
            error?: string;
            points?: Array<{ id: string; name: string; street: string; zip: string; city: string; distance: number }>;
          };
          if (!response.ok || !data.ok) throw new Error(data.error || 'Pickup-point search failed.');
          const points = (data.points ?? []).slice(0, 3);
          if (!points.length) {
            pickupMessage.textContent = 'No pickup points were found nearby. Try another postcode or carrier.';
            return;
          }
          pickupMessage.textContent = 'Choose one of these 3 nearby pickup points:';
          for (const point of points) {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'w-full rounded-md border border-line bg-white p-3 text-left text-sm hover:border-brand';
            const name = document.createElement('span');
            name.className = 'block font-medium';
            name.textContent = point.name;
            const address = document.createElement('span');
            address.className = 'mt-1 block text-xs text-muted';
            address.textContent = `${point.street}, ${point.zip} ${point.city}`;
            const distance = document.createElement('span');
            distance.className = 'mt-1 block text-xs text-muted';
            distance.textContent = point.distance > 0
              ? (point.distance < 1000 ? `${Math.round(point.distance)} m away` : `${(point.distance / 1000).toFixed(1)} km away`)
              : '';
            button.appendChild(name);
            button.appendChild(address);
            button.appendChild(distance);
            button.addEventListener('click', () => {
              pickupPointId.value = point.id;
              if (pickupSelected) {
                pickupSelected.textContent = `Selected: ${point.name}, ${point.street}, ${point.zip} ${point.city}`;
                pickupSelected.hidden = false;
              }
              Array.from(pickupResults.querySelectorAll('button')).forEach((item) => {
                item.classList.remove('border-brand', 'bg-brand/5');
              });
              button.classList.add('border-brand', 'bg-brand/5');
              pickupMessage.textContent = 'Pickup point selected.';
            });
            pickupResults.appendChild(button);
          }
        } catch (error) {
          pickupMessage.textContent = error instanceof Error ? error.message : 'Pickup-point search failed.';
        } finally {
          pickupSearch.disabled = false;
        }
      });
      deliveryForm.addEventListener('submit', (event) => {
        if (currentChoice() === 'pickup' && !pickupPointId.value) {
          event.preventDefault();
          pickupMessage.textContent = 'Search and select one of the 3 pickup points before continuing.';
          pickupSection.hidden = false;
          pickupSearch.focus();
        }
      });
    }
  }
</script>

</Layout>
